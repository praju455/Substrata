# Local scaffold server ports. Both servers bind to 127.0.0.1.
# setup copies this file to .env only if .env does not already exist.
# Shell environment variables override .env values.
SUBSTRATA_API_PORT=8000
SUBSTRATA_UI_PORT=3000

# Live extraction: Gemini primary, Groq backup. Keys stay on the backend.
# Use provider=mock explicitly for deterministic offline demos/tests.
SUBSTRATA_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
SUBSTRATA_GEMINI_MODEL=gemini-3.8-flash
SUBSTRATA_GROQ_MODEL=openai/gpt-oss-120b
SUBSTRATA_LLM_TIMEOUT_SECONDS=20
SUBSTRATA_INFERENCE_THRESHOLD=0.75
# Prototype assumption in synthetic USD; supplier switches always require review.
SUBSTRATA_SPEND_LIMIT=10000

# Tenant platform is opt-in; legacy replay is disabled by default in platform mode.
SUBSTRATA_PLATFORM_ENABLED=false
SUBSTRATA_ENV=development
SUBSTRATA_PLATFORM_DATABASE_URL=sqlite:///data/platform.sqlite3
# Production: use HTTPS OIDC issuer + JWKS URL; SAML may be brokered by the same IdP.
SUBSTRATA_OIDC_ISSUER=
SUBSTRATA_OIDC_AUDIENCE=substrata
SUBSTRATA_OIDC_JWKS_URL=
SUBSTRATA_AUTH_ALGORITHM=RS256
# Verification key, or local HS256 secret, loaded from a permission-restricted file.
SUBSTRATA_AUTH_KEY_FILE=
SUBSTRATA_SAP_WRITES_ENABLED=false
SUBSTRATA_CONNECTORS_FILE=
SUBSTRATA_EVENT_FEEDS_FILE=
# Comma-separated HTTPS feed host allowlist; feed configs also require license notes.
SUBSTRATA_EVENT_ALLOWED_HOSTS=
# Required by the NWS API when a tenant configures an nws_weather feed.
SUBSTRATA_NWS_USER_AGENT=
# Required for the official OFAC SDN XML feed; use an identifying app/contact string.
SUBSTRATA_OFAC_USER_AGENT=
# Supplier confirmation delivery is disabled in development; production uses implicit TLS.
SUBSTRATA_SMTP_HOST=
SUBSTRATA_SMTP_PORT=465
SUBSTRATA_SMTP_FROM=
SUBSTRATA_SMTP_USERNAME=
SUBSTRATA_SMTP_PASSWORD_FILE=
# Optional tenant-scoped approver recipients; addresses are encrypted in the outbox.
SUBSTRATA_APPROVER_EMAILS_FILE=
SUBSTRATA_OIDC_CLIENT_ID=
SUBSTRATA_OIDC_REDIRECT_URIS=
SUBSTRATA_OIDC_SCOPE=openid profile
SUBSTRATA_PLATFORM_LLM_PROVIDER=mock
SUBSTRATA_PLATFORM_LLM_MODEL=
SUBSTRATA_PLATFORM_LLM_KEY_FILE=
SUBSTRATA_PLATFORM_LLM_BASE_URL=
SUBSTRATA_PLATFORM_LLM_PRICES_FILE=
# Read-only domain assistant. `mock` is deterministic and offline; `auto` tries
# Google Gen AI SDK first and then the configured Groq fallback.
SUBSTRATA_ASSISTANT_PROVIDER=mock
SUBSTRATA_ASSISTANT_GEMINI_MODEL=gemini-3.8-flash
SUBSTRATA_ASSISTANT_GROQ_MODEL=openai/gpt-oss-120b
SUBSTRATA_ASSISTANT_TIMEOUT_SECONDS=20
# Optional controlled public-web retrieval. Keep blank for an offline demo.
TAVILY_API_KEY=
SUBSTRATA_TAVILY_MAX_RESULTS=5
# Optional comma-separated public domains. Blank allows Tavily's normal public index.
SUBSTRATA_TAVILY_ALLOWED_DOMAINS=
# Blank model selects labelled lexical embeddings for offline work.
SUBSTRATA_EMBEDDING_MODEL=
SUBSTRATA_EMBEDDING_BASE_URL=https://api.openai.com/v1
SUBSTRATA_EMBEDDING_KEY_FILE=
SUBSTRATA_EMBEDDING_PRICES_FILE=
SUBSTRATA_CONFIRMATION_KEY_FILE=
SUBSTRATA_PII_KEY_FILE=
SUBSTRATA_PORTAL_URL=http://127.0.0.1:3000/confirm/
SUBSTRATA_MODEL_REGISTRY=data/models

# Optional OTLP/HTTP tracing. Blank endpoint disables export and needs no collector.
# HTTPS is required outside development; local dev permits loopback HTTP only.
SUBSTRATA_OTLP_TRACES_ENDPOINT=
SUBSTRATA_TRACE_SAMPLE_RATIO=0.1
# Optional JSON headers (e.g. Authorization) from a backend-mounted secret file.
SUBSTRATA_OTLP_HEADERS_FILE=
# OTEL_SERVICE_NAME may override the stable API/worker service name; no tenant IDs.
